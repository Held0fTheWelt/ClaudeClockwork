  "operating_rules": {
    "core_principle": "Maximum 1 heavy inference at a time (OLLAMA_NUM_PARALLEL=1 enforces this)",
    "rule_1_load_hierarchy": [
      "Priority 1 (ONLY): TIER 5 (>36B) escalations",
      "Priority 2: TIER 4 (15-36B) implementation/review",
      "Priority 3: TIER 3 (9-16B) docs/creative",
      "Priority 4: TIER 2 (≤8.5B) validation/packing",
      "Priority 5: TIER 1 (embeddings) anytime"
    ],
    "rule_2_never_concurrent": [
      "NEVER load Tier 2 + Tier 2",
      "NEVER load Tier 2 + Tier 3+",
      "NEVER load Tier 3 + Tier 3+",
      "NEVER load Tier 4 + Tier 4+",
      "NEVER load Tier 5 + anything (except unloading first)"
    ],
    "rule_3_resource_guardrails": {
      "tier_2": {
        "max_active": 1,
        "min_free_ram_gb": 8,
        "min_free_vram_gb": 2,
        "timeout_sec": 120,
        "recovery": "automatic"
      },
      "tier_3": {
        "max_active": 1,
        "min_free_ram_gb": 16,
        "min_free_vram_gb": 3,
        "timeout_sec": 180,
        "recovery": "manual"
      },
      "tier_4": {
        "max_active": 1,
        "min_free_ram_gb": 20,
        "min_free_vram_gb": 4,
        "timeout_sec": 300,
        "recovery": "manual"
      },
      "tier_5": {
        "max_active": 1,
        "min_free_ram_gb": 25,
        "min_free_vram_gb": 5,
        "timeout_sec": 600,
        "recovery": "restart_recommended"
      }
    },
    "rule_4_serialization": {
      "when_tier_4_requested": [
        "1. Check status: curl http://localhost:11434/api/ps",
        "2. If empty: load model, wait for ready",
        "3. If busy: wait for current model to finish (up to timeout)",
        "4. If timeout: manual intervention required"
      ]
    }
  },
