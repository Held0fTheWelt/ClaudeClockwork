        "qwen2.5-72b:escalation",
        "llama3.3-70b:reasoning"
      ]
    }
  },
  "timeout_recovery": {
    "tier_2_120_seconds": {
      "action": "auto_recover",
      "procedure": "kill inference, unload model, free resources",
      "manual_action": "none"
    },
    "tier_3_180_seconds": {
      "action": "alert_operator",
      "procedure": "model timeout, manual unload required",
      "manual_action": "ollama rm <model_name>"
    },
    "tier_4_300_seconds": {
      "action": "critical_alert",
      "procedure": "system may be hung",
      "manual_action": "restart_ollama"
    },
    "tier_5_600_seconds": {
      "action": "critical_alert",
      "procedure": "system may be severely hung",
      "manual_action": "restart_system_recommended"
    }
  },
  "memory_guardrails": {
    "check_before_tier_4_load": {
      "available_ram_gb": 20,
      "action_if_insufficient": "reject_request"
    },
    "check_before_tier_5_load": {
      "available_ram_gb": 25,
      "action_if_insufficient": "reject_request"
    }
  },
  "environment_variables": {
    "required": {
      "OLLAMA_NUM_PARALLEL": "1",
      "OLLAMA_MMAP": "1",
      "OLLAMA_GPU": "1",
      "GGML_CUDA_NO_PINNED": "1"
    },
    "recommended": {
      "OLLAMA_KEEP_ALIVE": "30m",
      "OLLAMA_FLASH_ATTENTION": "1",
      "OLLAMA_LOAD_TIMEOUT": "120s"
    }
  },
  "status_checks": {
    "current_models_running": "curl http://localhost:11434/api/ps",
    "available_models_list": "curl http://localhost:11434/api/tags",
    "gpu_status": "nvidia-smi",
    "ollama_health": "curl http://localhost:11434/api/tags"
  },
  "three_core_rules": [
    {
      "rule": "Only 1 Tier 4+ Model at a Time",
      "detail": "OLLAMA_NUM_PARALLEL=1 enforces this. Never try to load 2 large models in parallel."
    },
    {
      "rule": "Check Resources Before Tier 4+",
      "detail": "Verify free RAM (20GB minimum) and free VRAM (5GB minimum). Reject request if guardrails violated."
    },
    {
      "rule": "Unload Tier 5 Immediately After Use",
      "detail": "Don't keep it resident. Set keep_alive=0 for cleanup. System is stable only with tier 5 unloaded."
    }
  ]
}
