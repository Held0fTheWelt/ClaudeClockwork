{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Plan",
  "description": "Contract for high-level code generation plans created before implementation",
  "type": "object",
  "required": [
    "task_id",
    "archetype",
    "module_structure",
    "key_functions",
    "dependencies",
    "safety_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier matching the forge request",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "description": "The type of skill being planned",
      "enum": [
        "scanner",
        "validator",
        "reporter",
        "transformer",
        "registry_helper"
      ]
    },
    "module_structure": {
      "type": "object",
      "description": "Proposed directory and file structure",
      "additionalProperties": true,
      "properties": {
        "root_package": {
          "type": "string",
          "description": "Root package name"
        },
        "modules": {
          "type": "array",
          "description": "List of module files to create",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "key_functions": {
      "type": "array",
      "description": "Primary functions/classes to implement",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Function or class name"
          },
          "signature": {
            "type": "string",
            "description": "Expected function signature or class definition"
          },
          "purpose": {
            "type": "string",
            "description": "What this function/class does"
          }
        },
        "required": ["name", "signature", "purpose"]
      }
    },
    "dependencies": {
      "type": "array",
      "description": "External dependencies required",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Dependency package name"
          },
          "version": {
            "type": "string",
            "description": "Version constraint or range"
          },
          "purpose": {
            "type": "string",
            "description": "Why this dependency is needed"
          }
        },
        "required": ["name"]
      }
    },
    "safety_notes": {
      "type": "object",
      "description": "Safety considerations and constraints",
      "additionalProperties": true,
      "properties": {
        "security_concerns": {
          "type": "array",
          "description": "List of security issues to avoid",
          "items": {
            "type": "string"
          }
        },
        "performance_hints": {
          "type": "array",
          "description": "Performance optimization notes",
          "items": {
            "type": "string"
          }
        },
        "no_operations": {
          "type": "array",
          "description": "Explicitly forbidden operations or patterns",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implementation_order": {
      "type": "array",
      "description": "Suggested order for implementing key functions",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the plan",
      "additionalProperties": true
    }
  }
}
