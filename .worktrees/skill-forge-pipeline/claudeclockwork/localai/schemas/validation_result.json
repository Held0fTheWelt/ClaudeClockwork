{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation Result",
  "description": "Contract for validation results verifying generated code quality and correctness",
  "type": "object",
  "required": [
    "task_id",
    "passed",
    "checks",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier matching the forge request",
      "minLength": 1
    },
    "passed": {
      "type": "boolean",
      "description": "Whether all validation checks passed"
    },
    "checks": {
      "type": "array",
      "description": "Results of individual validation checks",
      "items": {
        "type": "object",
        "properties": {
          "check_name": {
            "type": "string",
            "description": "Name of the validation check",
            "enum": [
              "schema_validation",
              "syntax_check",
              "import_resolution",
              "dependency_versions",
              "type_checking",
              "unit_tests",
              "integration_tests",
              "security_scan",
              "performance_baseline",
              "documentation_check",
              "archetype_compliance"
            ]
          },
          "passed": {
            "type": "boolean",
            "description": "Whether this check passed"
          },
          "status": {
            "type": "string",
            "description": "Status of the check",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "partial"
            ]
          },
          "details": {
            "type": "string",
            "description": "Detailed information about check results"
          },
          "metrics": {
            "type": "object",
            "description": "Quantitative metrics from the check",
            "additionalProperties": true,
            "properties": {
              "coverage_percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "test_count": {
                "type": "integer",
                "minimum": 0
              },
              "test_failures": {
                "type": "integer",
                "minimum": 0
              },
              "violations": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "errors": {
            "type": "array",
            "description": "List of errors encountered",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "check_name",
          "passed",
          "status"
        ]
      }
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when validation was performed",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Total validation duration in seconds",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "description": "Summary of validation results",
      "additionalProperties": true,
      "properties": {
        "total_checks": {
          "type": "integer",
          "description": "Total number of checks run",
          "minimum": 0
        },
        "passed_checks": {
          "type": "integer",
          "description": "Number of checks that passed",
          "minimum": 0
        },
        "failed_checks": {
          "type": "integer",
          "description": "Number of checks that failed",
          "minimum": 0
        },
        "skipped_checks": {
          "type": "integer",
          "description": "Number of checks that were skipped",
          "minimum": 0
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Recommendations for improvement if validation failed",
      "items": {
        "type": "string"
      }
    },
    "ready_for_deployment": {
      "type": "boolean",
      "description": "Whether the code is ready for production deployment"
    },
    "validator": {
      "type": "string",
      "description": "Identifier of the validation system used"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the validation",
      "additionalProperties": true
    }
  }
}
