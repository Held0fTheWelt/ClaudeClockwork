# Ollama Integration Environment Variables
#
# These variables are used by TaskExecutorService for intelligent task routing.
# See INTEGRATION_GUIDE.md and docs/ADR-004-ollama-first-routing-architecture.md for details.

# ============================================================================
# REQUIRED: Claude API (for L3-L4 fallback escalation)
# ============================================================================
# Set this to enable fallback to Claude API for complex tasks (L3-L4).
# If not set and L3-L4 task is routed: Claude call will fail gracefully.
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# Ollama Server Configuration (local-first routing)
# ============================================================================
# Hostname of Ollama server (default: localhost)
OLLAMA_HOST=localhost

# Port of Ollama server (default: 11434)
OLLAMA_PORT=11434

# Keep-alive timeout: models are unloaded after idle (default: 5m)
# OLLAMA_KEEP_ALIVE=5m

# ============================================================================
# Fallback Behavior (what to do if Ollama unavailable)
# ============================================================================
# If true (default): escalate L1-L2 to Claude when Ollama unavailable
# If false: fail with error when Ollama unavailable
# Set to false for strict offline-only mode
OLLAMA_FALLBACK_TO_CLAUDE=true

# ============================================================================
# Cost Control (optional, advanced)
# ============================================================================
# Token budget limit (optional, default: unlimited)
# Once exceeded, all subsequent tasks fail gracefully
# TOKEN_BUDGET_LIMIT=1000000

# Cost tracking (optional, for reporting)
# Cumulative cost in dollars tracked by TaskExecutor
# (read-only; incremented by execute_task)
