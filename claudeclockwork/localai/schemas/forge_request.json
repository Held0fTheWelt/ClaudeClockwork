{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Request",
  "description": "Contract for forge requests initiating the code generation pipeline",
  "type": "object",
  "required": [
    "task_id",
    "archetype",
    "purpose",
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier for the forge task",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "description": "The type of skill being forged",
      "enum": [
        "scanner",
        "validator",
        "reporter",
        "transformer",
        "registry_helper"
      ]
    },
    "purpose": {
      "type": "string",
      "description": "Clear statement of what the skill should accomplish",
      "minLength": 1
    },
    "constraints": {
      "type": "object",
      "description": "Constraints and requirements for the skill",
      "additionalProperties": true,
      "properties": {
        "max_complexity": {
          "type": "string",
          "description": "Maximum allowed code complexity level (simple, moderate, complex)"
        },
        "language": {
          "type": "string",
          "description": "Target programming language",
          "default": "python"
        },
        "dependencies_allowed": {
          "type": "array",
          "description": "List of allowed external dependencies",
          "items": {
            "type": "string"
          }
        },
        "no_external_calls": {
          "type": "boolean",
          "description": "If true, no external API or network calls allowed",
          "default": false
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the request",
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "task_id": "forge-001",
      "archetype": "scanner",
      "purpose": "Scan Python files for security vulnerabilities",
      "constraints": {
        "max_complexity": "moderate",
        "language": "python",
        "dependencies_allowed": ["ast"],
        "no_external_calls": true
      }
    },
    {
      "task_id": "forge-002",
      "archetype": "validator",
      "purpose": "Validate JSON schema compliance",
      "constraints": {
        "max_complexity": "simple",
        "language": "python"
      }
    }
  ]
}
