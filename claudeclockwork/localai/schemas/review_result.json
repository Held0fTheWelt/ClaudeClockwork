{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Result",
  "description": "Contract for code review feedback from the forge pipeline",
  "type": "object",
  "required": [
    "task_id",
    "approved",
    "issues"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier matching the forge result",
      "minLength": 1
    },
    "approved": {
      "type": "boolean",
      "description": "Whether the code passed review and is approved for validation"
    },
    "issues": {
      "type": "array",
      "description": "List of issues found during review",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "description": "Issue severity level",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "category": {
            "type": "string",
            "description": "Category of the issue",
            "enum": [
              "security",
              "performance",
              "style",
              "correctness",
              "documentation",
              "testing"
            ]
          },
          "location": {
            "type": "object",
            "description": "Where in the code the issue occurs",
            "properties": {
              "file": {
                "type": "string",
                "description": "Source file path"
              },
              "line": {
                "type": "integer",
                "description": "Line number"
              },
              "function": {
                "type": "string",
                "description": "Function or class name"
              }
            }
          },
          "message": {
            "type": "string",
            "description": "Detailed issue description"
          },
          "suggestion": {
            "type": "string",
            "description": "Suggested fix or improvement"
          }
        },
        "required": [
          "severity",
          "category",
          "message"
        ]
      }
    },
    "summary": {
      "type": "string",
      "description": "Overall review summary"
    },
    "error_count": {
      "type": "integer",
      "description": "Number of errors found",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "description": "Number of warnings found",
      "minimum": 0
    },
    "info_count": {
      "type": "integer",
      "description": "Number of informational items found",
      "minimum": 0
    },
    "recommendations": {
      "type": "array",
      "description": "High-level recommendations for improvement",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of review"
    },
    "reviewer": {
      "type": "string",
      "description": "Identifier of the reviewing agent or system"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the review",
      "additionalProperties": true
    }
  }
}
