{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Result",
  "description": "Contract for generated code output from the forge pipeline",
  "type": "object",
  "required": [
    "task_id",
    "archetype",
    "code",
    "manifest",
    "package_root"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier matching the forge request and plan",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "description": "The type of skill generated",
      "enum": [
        "scanner",
        "validator",
        "reporter",
        "transformer",
        "registry_helper"
      ]
    },
    "code": {
      "type": "object",
      "description": "Generated source code organized by module",
      "additionalProperties": {
        "type": "string",
        "description": "File path as key, source code as value"
      }
    },
    "manifest": {
      "type": "object",
      "description": "Metadata about the generated code",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string",
          "description": "Semantic version of the generated skill"
        },
        "entry_point": {
          "type": "string",
          "description": "Main module and function to invoke"
        },
        "functions_exported": {
          "type": "array",
          "description": "List of public functions/classes exported",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "description": "Required external dependencies",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": ["name"]
          }
        },
        "configuration": {
          "type": "object",
          "description": "Runtime configuration options",
          "additionalProperties": true
        }
      }
    },
    "package_root": {
      "type": "string",
      "description": "Root package name for the generated code",
      "minLength": 1
    },
    "tests": {
      "type": "object",
      "description": "Optional test code organized by module",
      "additionalProperties": {
        "type": "string",
        "description": "Test file path as key, test code as value"
      }
    },
    "documentation": {
      "type": "object",
      "description": "Optional documentation files",
      "additionalProperties": {
        "type": "string",
        "description": "Doc file path as key, markdown content as value"
      }
    },
    "quality_metrics": {
      "type": "object",
      "description": "Code quality metrics",
      "additionalProperties": true,
      "properties": {
        "estimated_coverage": {
          "type": "number",
          "description": "Estimated test coverage percentage",
          "minimum": 0,
          "maximum": 100
        },
        "complexity_score": {
          "type": "string",
          "description": "Cyclomatic complexity assessment (low, medium, high)"
        },
        "warnings": {
          "type": "array",
          "description": "Any quality or style warnings",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the generation",
      "additionalProperties": true,
      "properties": {
        "generated_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of generation"
        },
        "generator_version": {
          "type": "string",
          "description": "Version of the forge generator used"
        }
      }
    }
  }
}
