{
  "id": "code_apply",
  "name": "code_apply",
  "version": "1.0.0",
  "category": "localai",
  "description": "Apply generated code to repository files. Allows Ollama agents to write implementation changes.",
  "entrypoint": "skills.localai.code_apply.skill:CodeApplySkill",
  "permissions": [
    "repo:read",
    "repo:write"
  ],
  "aliases": [
    "apply_code",
    "write_file"
  ],
  "tags": [
    "ollama",
    "code",
    "apply",
    "file-write",
    "implementation"
  ],
  "enabled": true,
  "trust_level": "local",
  "inputs": {
    "file_path": {
      "type": "string",
      "required": true,
      "description": "Target file path relative to project root (e.g., .claude/tools/lib/version_manager.py)"
    },
    "content": {
      "type": "string",
      "required": true,
      "description": "Code/content to write to file"
    },
    "create_if_missing": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Create file if it doesn't exist"
    },
    "make_dirs": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Create parent directories if needed"
    }
  },
  "outputs": {
    "success": {
      "type": "boolean",
      "description": "Whether file write succeeded"
    },
    "file_path": {
      "type": "string",
      "description": "Full path to written file"
    },
    "error": {
      "type": "string",
      "description": "Error message if write failed"
    }
  },
  "metadata": {
    "legacy_bridge": false,
    "ollama_binding": true,
    "pure_execution": true,
    "mode_requirements": {
      "requires_mode": [
        "default",
        "adaptive"
      ],
      "agent_type": "ollama"
    }
  }
}
